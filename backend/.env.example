# ==============================================================================
# GWAS Platform Backend - Development Environment
# ==============================================================================
# Salin file ini menjadi backend/.env.
# Docker Compose meng-override DATABASE_URL, CELERY_* dan STORAGE_ROOT dengan
# hostname/network path internal container. Jangan commit backend/.env asli.

# ------------------------------------------------------------------------------
# API & Security
# ------------------------------------------------------------------------------

# Mode aplikasi. Selain memengaruhi logging, ENV=development membuat cookie
# refresh token tidak wajib Secure saat local development.
ENV=development

# Level log ke stdout container: DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO

# Secret untuk signing JWT. Ganti dengan nilai acak minimal 32 byte.
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=replace-with-a-long-random-jwt-secret

# Fallback Settings yang disediakan config.py. Modul security saat ini membaca
# JWT_SECRET_KEY secara langsung, jadi keduanya sebaiknya diisi konsisten.
SECRET_KEY=replace-with-a-long-random-jwt-secret

# Masa berlaku access token dalam menit.
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Origin frontend yang diizinkan. Saat ini main.py memakai fallback
# http://localhost:5173 jika CORS_ORIGINS belum ditambahkan ke Settings.
# Format yang disiapkan untuk implementasi berikutnya: JSON list.
CORS_ORIGINS=["http://localhost:5173"]

# ------------------------------------------------------------------------------
# PostgreSQL Database
# ------------------------------------------------------------------------------

# Docker Compose: hostname service adalah db.
DATABASE_URL=postgresql+psycopg2://gwas_user:gwas_password@db:5432/gwas_db

# Nilai ini harus sama dengan environment service db pada docker-compose.yml.
POSTGRES_USER=gwas_user
POSTGRES_PASSWORD=change-this-development-password
POSTGRES_DB=gwas_db
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ------------------------------------------------------------------------------
# Redis & Celery
# ------------------------------------------------------------------------------

# Docker Compose: hostname service Redis adalah redis.
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
REDIS_HOST=redis
REDIS_PORT=6379

# ------------------------------------------------------------------------------
# Storage & File Paths
# ------------------------------------------------------------------------------

# Root shared volume yang harus sama antara backend dan celery_worker.
STORAGE_ROOT=/data/storage

# Subdirektori yang digunakan/direncanakan untuk memisahkan data besar.
# upload_service.py saat ini membentuk STORAGE_ROOT/staging dan
# STORAGE_ROOT/datasets secara internal.
RAW_VCF_DIR=/data/storage/datasets
STAGING_DIR=/data/storage/staging
INTERMEDIATE_DIR=/data/storage/intermediate
RESULTS_DIR=/data/storage/results
REFERENCE_PANELS_DIR=/data/reference-panels
JOBS_DIR=/data/jobs

# ------------------------------------------------------------------------------
# Upload VCF Masif
# ------------------------------------------------------------------------------

# Ukuran chunk upload dalam byte. Nilai 10 MiB membatasi kebutuhan memory dan
# membantu resume upload; endpoint saat ini menerima chunk_index/total_chunks,
# tetapi ukuran chunk belum dibaca dari Settings.
UPLOAD_CHUNK_SIZE_BYTES=10485760

# Batas ukuran file total dalam byte. 0 berarti belum ditegakkan oleh backend;
# tambahkan validasi pada route bila ingin mengaktifkannya.
MAX_UPLOAD_SIZE_BYTES=0

# Ukuran buffer copy file internal upload_service.py (1 MiB saat ini).
UPLOAD_COPY_BUFFER_SIZE_BYTES=1048576

# ------------------------------------------------------------------------------
# Bioinformatics Tools
# ------------------------------------------------------------------------------

# Binary yang dipanggil Celery pipeline tasks. Di Dockerfile, plink dan gemma
# dipasang ke /usr/local/bin sehingga nama default ini dapat langsung dipakai.
PLINK_BINARY_PATH=plink
GEMMA_BINARY_PATH=gemma
IMPUTATION_BINARY_PATH=beagle

# Lokasi JAR Beagle di dalam image/worker container.
BEAGLE_JAR_PATH=/opt/tools/beagle.jar

# Nilai dokumentasi batas heap JVM yang diharapkan. Implementasi imputasi saat
# ini menghitung -Xmx dari IMPUTATION_CONTAINER_MEM_LIMIT_MB melalui
# resource_limits.py; hubungkan BEAGLE_MAX_MEMORY jika ingin override langsung.
BEAGLE_MAX_MEMORY=-Xmx8g

# Batas memory container worker imputasi dalam MiB. resource_limits.py memakai
# 75% nilai ini sebagai heap Java dan menyisakan headroom untuk native memory.
IMPUTATION_CONTAINER_MEM_LIMIT_MB=8192

# Timeout satu task imputasi dalam detik (6 jam).
IMPUTATION_TIMEOUT_SECONDS=21600

# Timeout satu task GEMMA, termasuk konversi genotype dan analisis association.
GEMMA_TIMEOUT_SECONDS=21600

# ------------------------------------------------------------------------------
# Worker & Pipeline Operations
# ------------------------------------------------------------------------------

# Jumlah proses task Celery paralel untuk development.
CELERY_WORKER_CONCURRENCY=2

# Retention policy: dipakai oleh retention_tasks.py bila Settings diperluas
# untuk membaca kedua variabel ini.
RETENTION_DAYS=30
RETENTION_HARD_DELETE=false

# ------------------------------------------------------------------------------
# Local Development Override
# ------------------------------------------------------------------------------

# Jika FastAPI dijalankan langsung dari host, ganti hostname service Docker:
# DATABASE_URL=postgresql+psycopg2://gwas_user:gwas_password@localhost:5432/gwas_db
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/1
# STORAGE_ROOT=./storage
