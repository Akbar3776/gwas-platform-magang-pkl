# ==============================================================================
# GWAS Platform Backend - Environment Configuration Template
# ==============================================================================
# Petunjuk Penggunaan:
# 1. Salin berkas ini ke `backend/.env` (atau `.env` di root untuk Docker Compose).
# 2. Untuk lingkungan PRODUKSI, WAJIB mengganti seluruh kredensial (JWT_SECRET_KEY,
#    SECRET_KEY, POSTGRES_PASSWORD) dengan nilai acak >= 32 karakter.
# 3. JANGAN PERNAH melakukan commit terhadap berkas `.env` yang berisi kredensial asli.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Lingkungan Aplikasi & Logging (API & Security Core)
# ------------------------------------------------------------------------------

# Mode aplikasi: `development` atau `production`.
# Pada mode `production`, cookie refresh token dipaksa `Secure=True` dan
# JWT_SECRET_KEY wajib >= 32 karakter non-placeholder.
ENV=development
LOG_LEVEL=INFO

# Kunci rahasia penandatangan JWT (python -c "import secrets; print(secrets.token_hex(32))").
JWT_SECRET_KEY=change-this-jwt-secret-key-in-production-min-32-chars
SECRET_KEY=change-this-secret-key-in-production-min-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Daftar origin frontend yang diizinkan untuk CORS (JSON array; hindari "*" dengan credentials).
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost"]

# ------------------------------------------------------------------------------
# 2. Database Relasional (PostgreSQL / SQLite Fallback)
# ------------------------------------------------------------------------------

DATABASE_URL=postgresql+psycopg2://gwas_user:change-this-postgres-password@db:5432/gwas_db
# Set true hanya untuk dev lokal tanpa PostgreSQL; WAJIB false di produksi.
ALLOW_SQLITE_FALLBACK=false

# Kredensial PostgreSQL (sinkron dengan container db di infra/docker-compose*.yml).
POSTGRES_USER=gwas_user
POSTGRES_PASSWORD=change-this-postgres-password
POSTGRES_DB=gwas_db

# ------------------------------------------------------------------------------
# 3. Asynchronous Task Queue (Redis & Celery)
# ------------------------------------------------------------------------------

CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ------------------------------------------------------------------------------
# 4. Penyimpanan Berkas (Shared Storage Volume)
# ------------------------------------------------------------------------------

# Di Windows lokal (non-Docker), config.py mengalihkan path `/data/...` ke `backend/data/storage`.
STORAGE_ROOT=/data/storage

# ------------------------------------------------------------------------------
# 5. Batasan Unggah (Upload Constraints)
# ------------------------------------------------------------------------------

# Ukuran chunk upload dikontrol frontend (10 MiB) dan divalidasi backend per chunk (16 MiB).
MAX_CHUNK_SIZE_BYTES=16777216
# Batas total ukuran unggahan dalam byte (0 = tidak dibatasi).
MAX_UPLOAD_SIZE_BYTES=0

# ------------------------------------------------------------------------------
# 6. Perangkat Bioinformatika, Batas Memori, & Timeout Pipeline
# ------------------------------------------------------------------------------

PLINK_BINARY_PATH=plink
PLINK2_BINARY_PATH=plink2
BCFTOOLS_BINARY_PATH=bcftools
GEMMA_BINARY_PATH=gemma
IMPUTATION_BINARY_PATH=beagle
R_BINARY_PATH=Rscript

BEAGLE_JAR_PATH=/opt/tools/beagle.jar
BEAGLE_LIB_DIR=
BEAGLE_LIB_BIN_DIR=

# Kosongkan agar JVM memakai 75% limit container via MaxRAMPercentage; override -XmxN
# dipotong maksimal 75% limit container. RLIMIT_AS tidak dipakai untuk Beagle.
BEAGLE_MAX_MEMORY=
# GAPIT OOM pada 1 juta SNP di worker 4 GB; pruning LD r2 0.8 membatasi input.
GAPIT_MAX_SNPS=300000

NORMALIZATION_TIMEOUT_SECONDS=7200
QC_TIMEOUT_SECONDS=21600
IMPUTATION_TIMEOUT_SECONDS=21600
GEMMA_TIMEOUT_SECONDS=21600
MULTILOCUS_TIMEOUT_SECONDS=21600

# Kontrol fitur fallback/mode runtime
ALLOW_PYTHON_MULTILOCUS=true
ALLOW_SYNTHETIC_ANNOTATION=false
CONTAINER_MODE=false

# Split kromosom > 32-bit, batas ekspor region kandidat, panjang flank KASP, dan filter kontig non-utama
CHROM_SPLIT_THRESHOLD_BP=2147483647
CHROM_SPLIT_UNIT_BP=1000000000
CANDIDATE_REGION_MAX_TOTAL_BP=50000000
KASP_FLANK_BP=150
# Regex blacklist untuk membuang scaffold/kontig non-utama pada tahap normalisasi (kosongkan untuk menonaktifkan)
NON_PRIMARY_CONTIG_REGEX=(?i)^(scaffold|contig|ctg|unplaced|chrun)|_(random|unplaced|alt)$

# Batas unggahan pemetaan GO & pembacaan teks terbatas (anti gzip-bomb)
GO_MAPPING_MAX_UPLOAD_BYTES=52428800
GO_MAPPING_MAX_DECOMPRESSED_BYTES=134217728
GO_MAPPING_MAX_LINES=1000000
GO_MAPPING_MIN_VALID_RATIO=0.5
UPLOAD_TEXT_MAX_LINE_BYTES=65536
# Biarkan dikomentari agar env_file compose tidak menimpa ENV GO_OBO_PATH di Docker image
# GO_OBO_PATH=/opt/go/go-basic.obo
GO_OBO_MAX_BYTES=209715200
GO_OBO_MAX_LINES=2000000
# Batas unggahan dan parsing file BLAST outfmt6 ortolog (95 MiB upload, 512 MiB dekompresi)
ORTHOLOG_MAX_UPLOAD_BYTES=99614720
ORTHOLOG_MAX_DECOMPRESSED_BYTES=536870912
ORTHOLOG_MAX_LINES=10000000
ORTHOLOG_MAX_QUERIES=500000

# ------------------------------------------------------------------------------
# 7. Kebijakan Retensi & Pembersihan Data
# ------------------------------------------------------------------------------

RETENTION_DAYS=30
RETENTION_HARD_DELETE=false
