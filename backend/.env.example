# ==============================================================================
# GWAS Platform Backend - Environment Configuration Template
# ==============================================================================
# Petunjuk Penggunaan:
# 1. Salin berkas ini ke `backend/.env` (atau `.env` di root untuk docker-compose).
# 2. Untuk lingkungan PRODUKSI, WAJIB mengubah seluruh nilai rahasia (JWT_SECRET_KEY,
#    SECRET_KEY, POSTGRES_PASSWORD) menjadi nilai acak yang aman.
# 3. JANGAN PERNAH melakukan commit terhadap berkas `.env` yang berisi kredensial asli!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Lingkungan Aplikasi & Logging (API & Security Core)
# ------------------------------------------------------------------------------

# Mode aplikasi: `development` atau `production`.
# PENTING: Pada mode `production`, cookie refresh token otomatis dipaksa `Secure=True`
# (hanya terkirim lewat HTTPS), format log dibuat ringkas, dan stack trace internal disembunyikan.
ENV=development

# Level log ke stdout container/console: DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO

# Kunci rahasia untuk menandatangani JSON Web Token (JWT).
# WAJIB diganti dengan string acak kriptografis minimal 32 byte (256-bit) di produksi!
# Perintah generate: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-this-jwt-secret-key-in-production-min-32-chars

# Kunci rahasia umum aplikasi (fallback enkripsi session/token).
SECRET_KEY=change-this-secret-key-in-production-min-32-chars

# Masa berlaku Access Token dalam satuan menit (rekomendasi: 15-60 menit untuk keamanan).
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Daftar origin frontend yang diizinkan untuk Cross-Origin Resource Sharing (CORS).
# Format: JSON array berisi string URL origin.
# KEAMANAN: Jangan gunakan wildcard `*` jika `allow_credentials=True`!
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost"]

# ------------------------------------------------------------------------------
# 2. Database Relasional (PostgreSQL / SQLite Fallback)
# ------------------------------------------------------------------------------

# URL koneksi SQLAlchemy.
# Docker Compose default: menggunakan service `db` (PostgreSQL 15).
DATABASE_URL=postgresql+psycopg2://gwas_user:change-this-postgres-password@db:5432/gwas_db

# Alternatif untuk Local Development Mandiri tanpa Docker (SQLite):
# DATABASE_URL=sqlite:///./data/gwas.db

# Kredensial PostgreSQL (harus sinkron dengan konfigurasi container db di docker-compose.yml):
POSTGRES_USER=gwas_user
POSTGRES_PASSWORD=change-this-postgres-password
POSTGRES_DB=gwas_db
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ------------------------------------------------------------------------------
# 3. Asynchronous Task Queue (Redis 7 & Celery 5.4)
# ------------------------------------------------------------------------------

# URL Broker dan Result Backend Celery.
# Docker Compose: hostname service adalah `redis`.
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# Alternatif jika Redis dijalankan di host lokal (tanpa docker):
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/1

REDIS_HOST=redis
REDIS_PORT=6379

# Jumlah konkurensi worker Celery (sesuaikan dengan core CPU mesin).
CELERY_WORKER_CONCURRENCY=2

# ------------------------------------------------------------------------------
# 4. Penyimpanan Berkas & Isolasi Data (Storage & Filesystem)
# ------------------------------------------------------------------------------

# Root shared volume yang dapat diakses bersama oleh container backend dan celery_worker.
# Di Windows lokal (non-docker), otomatis dialihkan ke `./data/storage` oleh config.py.
STORAGE_ROOT=/data/storage

# Struktur direktori internal di bawah STORAGE_ROOT:
RAW_VCF_DIR=/data/storage/datasets
STAGING_DIR=/data/storage/staging
INTERMEDIATE_DIR=/data/storage/intermediate
RESULTS_DIR=/data/storage/results
JOBS_DIR=/data/jobs
REFERENCE_PANELS_DIR=/data/reference-panels

# ------------------------------------------------------------------------------
# 5. Batasan Unggah & Integritas File (Upload Constraints)
# ------------------------------------------------------------------------------

# Ukuran potongan (chunk) upload dalam byte (5 MiB = 5242880 byte).
# Nilai ini disinkronkan dengan chunking frontend React untuk upload VCF berukuran besar.
UPLOAD_CHUNK_SIZE_BYTES=5242880

# Batas ukuran total berkas unggahan dalam byte (0 = tidak dibatasi / diatur di Nginx).
# Untuk membatasi ukuran file pada level gateway backend, tentukan nilai byte (misal: 10737418240 untuk 10 GB).
MAX_UPLOAD_SIZE_BYTES=0

# Ukuran buffer copy internal saat menggabungkan chunk (1 MiB = 1048576 byte).
UPLOAD_COPY_BUFFER_SIZE_BYTES=1048576

# ------------------------------------------------------------------------------
# 6. Jalur Eksekusi Perangkat Bioinformatika (Bioinformatics Tools)
# ------------------------------------------------------------------------------

# Path ke executable CLI bioinformatika.
# Di dalam container Docker, seluruh tool dipasang di `/usr/local/bin` atau `/usr/bin`.
# Pada Windows/WSL, biarkan kosong untuk deteksi PATH otomatis, atau tentukan path absolut.
PLINK_BINARY_PATH=plink
PLINK2_BINARY_PATH=plink2
BCFTOOLS_BINARY_PATH=bcftools
GEMMA_BINARY_PATH=gemma
IMPUTATION_BINARY_PATH=beagle
R_BINARY_PATH=Rscript

# Lokasi file JAR Beagle 5.4 dan library pendukung:
BEAGLE_JAR_PATH=/opt/tools/beagle.jar
BEAGLE_LIB_DIR=
BEAGLE_LIB_BIN_DIR=

# Konfigurasi Memori Java Virtual Machine (JVM) untuk Beagle:
# Nilai maksimum heap RAM untuk imputasi.
BEAGLE_MAX_MEMORY=-Xmx8g

# Batas memori container worker untuk task imputasi dalam MiB (8192 MiB = 8 GiB).
IMPUTATION_CONTAINER_MEM_LIMIT_MB=8192

# Batas waktu timeout eksekusi task imputasi dalam detik (21600 detik = 6 jam).
IMPUTATION_TIMEOUT_SECONDS=21600

# Batas waktu timeout eksekusi kalkulasi asosiasi GEMMA dalam detik (21600 detik = 6 jam).
GEMMA_TIMEOUT_SECONDS=21600

# ------------------------------------------------------------------------------
# 7. Kebijakan Retensi & Privasi Data (Data Lifecycle & GDPR/Privacy)
# ------------------------------------------------------------------------------

# Masa simpan berkas job dan dataset sebelum ditandai kedaluwarsa (dalam satuan hari).
RETENTION_DAYS=30

# Mode penghapusan:
# `false` = Soft-delete (menandai kolom deleted_at di database untuk jejak audit).
# `true`  = Hard-delete (menghapus permanen berkas fisik dari disk penyimpanan).
RETENTION_HARD_DELETE=false
