# ==============================================================================
# GWAS Platform - Root / Docker Compose Environment Configuration Template
# ==============================================================================
# Salin berkas ini ke `.env` di root untuk Docker Compose, atau ke `backend/.env`.
# Rujuk `backend/.env.example` untuk dokumentasi teknis mendalam setiap variabel.
# ==============================================================================

ENV=development
LOG_LEVEL=INFO

# Security Keys (GANTI DI PRODUKSI: python -c "import secrets; print(secrets.token_hex(32))")
JWT_SECRET_KEY=change-this-jwt-secret-key-in-production-min-32-chars
SECRET_KEY=change-this-secret-key-in-production-min-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost"]

# Database PostgreSQL
DATABASE_URL=postgresql+psycopg2://gwas_user:change-this-postgres-password@db:5432/gwas_db
POSTGRES_USER=gwas_user
POSTGRES_PASSWORD=change-this-postgres-password
POSTGRES_DB=gwas_db
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Redis & Celery Task Queue
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
REDIS_HOST=redis
REDIS_PORT=6379
CELERY_WORKER_CONCURRENCY=2

# Storage Root (Shared Volume)
STORAGE_ROOT=/data/storage
RAW_VCF_DIR=/data/storage/datasets
STAGING_DIR=/data/storage/staging
INTERMEDIATE_DIR=/data/storage/intermediate
RESULTS_DIR=/data/storage/results
JOBS_DIR=/data/jobs
REFERENCE_PANELS_DIR=/data/reference-panels

# Upload Constraints
UPLOAD_CHUNK_SIZE_BYTES=5242880
MAX_UPLOAD_SIZE_BYTES=0
UPLOAD_COPY_BUFFER_SIZE_BYTES=1048576

# Bioinformatics CLI Paths
PLINK_BINARY_PATH=plink
PLINK2_BINARY_PATH=plink2
BCFTOOLS_BINARY_PATH=bcftools
GEMMA_BINARY_PATH=gemma
IMPUTATION_BINARY_PATH=beagle
R_BINARY_PATH=Rscript
BEAGLE_JAR_PATH=/opt/tools/beagle.jar
BEAGLE_LIB_DIR=
BEAGLE_LIB_BIN_DIR=
BEAGLE_MAX_MEMORY=-Xmx8g
IMPUTATION_CONTAINER_MEM_LIMIT_MB=8192
IMPUTATION_TIMEOUT_SECONDS=21600
GEMMA_TIMEOUT_SECONDS=21600

# Retention & Data Lifecycle
RETENTION_DAYS=30
RETENTION_HARD_DELETE=false
